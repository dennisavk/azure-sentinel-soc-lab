// Rule: Brute Force - Excessive Failed Logons from Single IP
// MITRE ATT&CK: T1110 (Brute Force) | Tactic: Credential Access (TA0006)
// Source: SecurityEvent (Windows Security events via Azure Monitor Agent)

// ---- AS BUILT (rule running in the lab) ----
SecurityEvent
| where EventID == 4625
| summarize
    FailedAttempts = count(),
    TargetedAccounts = make_set(Account)
    by IpAddress, Computer, bin(TimeGenerated, 5m)

